PHOENIX_START_SLOT=a
PHOENIX_PROBE_INTERVAL_SECONDS=2
# Optional full SHA of the checkout fault commit for a demo run.
PHOENIX_BAD_REV=

# AI layer. Missing optional keys skip that feature with a visible note.
# gemini-* models use GEMINI_API_KEY; claude-* models use ANTHROPIC_API_KEY.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
MODEL_FAST=gemini-3.5-flash-lite
MODEL_STRONG=gemini-3.8-flash
# Tried in order when a Gemini model is overloaded or its free quota is used up.
MODEL_FALLBACKS=gemini-3.6-flash,gemini-3.5-flash-lite
TAVILY_API_KEY=
BRAVE_API_KEY=
GITHUB_TOKEN=
# A separate demo repo, never ALTF4
GITHUB_REPO=arshtomar583/phoenix-shop-demo
PHOENIX_SHOP_REPO=./.data/shoplite-repo
PHOENIX_LAB_DIR=./.data/lab
PHOENIX_LOG_DIR=./.data/logs
